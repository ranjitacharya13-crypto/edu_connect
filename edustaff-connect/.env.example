PORT=5000
DB_MODE=local
MONGODB_DB_NAME=edustaff-connect
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/edustaff-connect
# Optional remote provider configuration; local mode above does not use it.
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/edustaff-connect?retryWrites=true&w=majority
# Legacy alias supported for existing deployments; MONGODB_ATLAS_URI takes precedence.
MONGODB_URI=
CLIENT_ORIGIN=http://localhost:5173
# Required public HTTPS API base for Capacitor/Android builds. Leave blank for
# the browser build, which uses Vite's same-origin /api proxy.
VITE_API_BASE_URL=
# Same-origin path or absolute HTTPS URL to a verified EduConnect APK.
VITE_ANDROID_APK_URL=/downloads/educonnect.apk
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_SENDER_ID=
PUBLIC_WEBHOOK_URL=https://your-domain.example/api/communications/webhook/twilio
